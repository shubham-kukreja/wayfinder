# FRED API v2 (Nov 2025+) requires a key for all requests.
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# metals.dev free tier: 100 req/month. https://metals.dev/
METALS_DEV_API_KEY=

# Path to the SQLite database file.
DB_PATH=./data/wayfinder.db

# playwright-core (used by the RBI and NSE adapters) ships no browser binary.
# Point this at an existing Chromium/Chrome executable, or leave unset and
# run `npx playwright install chromium` once so the default lookup works.
CHROMIUM_EXECUTABLE_PATH=

# Shared secret required on POST/PUT/PATCH/DELETE. Leave unset locally;
# ALWAYS set it on a public deployment, or anyone can rewrite or delete
# your data. Generate one with: openssl rand -hex 32
API_SECRET=

# Comma-separated exact browser origins allowed to call the API, e.g.
# https://wayfinder.vercel.app. Unset reflects any origin (dev only).
ALLOWED_ORIGINS=
